{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hardware-os.org/schema/v1/kernel/manifest-schema.json",
  "title": "Hardware-OS Kernel Manifest (minimal)",
  "type": "object",
  "required": ["hdVersion", "schemaVersion", "layers"],
  "properties": {
    "hdVersion": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "project": { "type": "string" },
    "created": { "type": "string", "format": "date-time" },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["layerId", "file"],
        "properties": {
          "layerId": { "type": "string" },
          "file": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "history": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

